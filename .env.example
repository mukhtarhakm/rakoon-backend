# ==========================================
# Database & Supabase Configuration
# ==========================================
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<supabase_service_role_key>
DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require

# ==========================================
# AI Vision Pipeline (OpenAI-compatible)
# ==========================================
OPENAI_API_KEY=<openai_api_key>
OPENAI_BASE_URL=https://api.openai.com/v1
PRIMARY_VISION_MODEL=gpt-5.6-luna

# ==========================================
# Authentication & Role
# ==========================================
ADMIN_EMAILS=admin@example.test

# ==========================================
# Environment & Feature Flags
# ==========================================
RAKOON_ENV=development
ENVIRONMENT=development
ALLOW_DEMO_ADS=false

# ==========================================
# Xendit Payment Gateway (Sandbox)
# ==========================================
XENDIT_SECRET_KEY=<xendit_development_secret_key>
XENDIT_WEBHOOK_TOKEN=<xendit_webhook_verification_token>
XENDIT_ENVIRONMENT=sandbox
XENDIT_SUCCESS_REDIRECT_URL=https://example.test/ads/payment-success
XENDIT_FAILURE_REDIRECT_URL=https://example.test/ads/payment-failed

# ==========================================
# Migration Guards (Hanya untuk migrasi remote manual dari mesin pengembang)
# ==========================================
ALLOW_REMOTE_MIGRATION=false
EXPECTED_DATABASE_HOST=<expected_database_host>
EXPECTED_DATABASE_PORT=5432
EXPECTED_DATABASE_NAME=<expected_database_name>
EXPECTED_DATABASE_USER=<expected_database_user>
EXPECTED_SUPABASE_PROJECT_REF=<expected_supabase_project_ref>
