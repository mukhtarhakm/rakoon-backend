# =============================================================================
# Rakoon Backend - Environment Variables
# Salin file ini menjadi .env dan isi nilainya
# JANGAN commit file .env ke git!
# =============================================================================

# --- Supabase ---
# URL project Supabase kamu
# Contoh: https://xxxxxxxxxxx.supabase.co
SUPABASE_URL=

# Service Role Key dari Supabase (Settings > API > service_role)
# RAHASIA - jangan bagikan ke siapapun
SUPABASE_SERVICE_KEY=

# --- Database ---
# PostgreSQL connection string dari Supabase
# Ambil dari: Supabase Dashboard > Settings > Database > Connection string (URI mode)
# Gunakan "Transaction" pooler (port 6543) untuk serverless/Render
DATABASE_URL=

# --- AI Vision (OpenAI) ---
# API Key dari https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Base URL endpoint (opsional, default: https://api.openai.com/v1)
OPENAI_BASE_URL=https://api.openai.com/v1
# Model Vision utama (default: gpt-5.6-luna)
PRIMARY_VISION_MODEL=gpt-5.6-luna

# --- Admin Authorization (RBAC) ---
# Daftar email admin (dipisahkan koma) untuk akses endpoint kurasi katalog & foto produk
ADMIN_EMAILS=admin@rakoon.app,eufratayyash870@gmail.com
